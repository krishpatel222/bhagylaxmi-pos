# Bhagyalaxmi Enterprise POS - Environment Configuration Example
# Copy this file to .env and set your production values

# Django Settings
SECRET_KEY=change-this-to-a-secure-random-key-in-production-1234567890
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://your-app-name.onrender.com
RENDER_EXTERNAL_HOSTNAME=your-app-name.onrender.com

# Render Database Configuration (PostgreSQL URL provided by Render)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Local Database Fallback Configuration (Defaults to SQLite if DATABASE_URL is empty)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# Timezone & Language
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us

# Security Settings (Set to True in Production with HTTPS on Render)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
