# Bhagyalaxmi Enterprise POS - Environment Configuration Example
# Copy this file to .env and set your production values

# Django Settings
SECRET_KEY=change-this-to-a-secure-random-key-in-production-1234567890
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://yourdomain.com

# Database Configuration (Defaults to SQLite if DB_ENGINE is empty)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=bhagyalaxmi_pos
# DB_USER=pos_user
# DB_PASSWORD=secure_password
# DB_HOST=localhost
# DB_PORT=5432

# Timezone & Language
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us

# Security Settings (Set to True in Production with HTTPS)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
